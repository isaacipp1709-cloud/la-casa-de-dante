# La Casa de Dante — Environment template

# ==========================================
# Variables Core Bridge (Obligatorias)
# ==========================================
# Token compartido con el Core para autenticación server-to-server
DANTE_CORE_TOKEN="your_secure_server_to_server_token_here"

# URL pública o local del Core (ej: https://dante-ai-core.vercel.app o http://localhost:3001)
DANTE_CORE_URL="https://dante-ai-core.vercel.app"

# Modo del Bridge ('local-core' para usar el backend real, 'mock' para desarrollo sin backend)
DANTE_MODE="local-core"

# ==========================================
# Adaptadores de IA (Fase 6)
# ==========================================
GOOGLE_AI_API_KEY="your_gemini_api_key_here"
HUGGING_FACE_API_KEY="your_hf_token_here"
OLLAMA_BASE_URL="http://localhost:11434"

# ==========================================
# Variables Anteriores / Legado
# ==========================================
STITCH_API_KEY="your_stitch_key_here"
GROQ_API_KEY="your_groq_key_here"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_anon_key_here"
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key_here"
GITHUB_TOKEN="your_github_token_here"
